# Supabase config for local dev. Copy to .env and fill in from `supabase status`
# (or Dashboard -> Project Settings -> API for a cloud project).
#
# Note: this project runs its local Supabase stack on the 544xx port range (see
# supabase/config.toml) so it can coexist with other local Supabase projects.

# Public — safe to expose in the browser
PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Private — only available to SvelteKit server code (never shipped to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
